# Copy this file to .env for local development and replace values as needed.
# Never put real production credentials in this tracked example.
# DOTENV_PATH is set by the host/process (not inside this file) when an explicit
# absolute .env location is required.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:7216;http://localhost:5268
ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=VranjicDb;Trusted_Connection=True;MultipleActiveResultSets=true

# Required outside Development. Separate multiple host names with semicolons.
AllowedHosts=localhost

# Optional. Leave unset for the production same-origin React build.
Cors__AllowedOrigins__0=http://localhost:5173

# Optional one-time administrative seed. Keep disabled unless explicitly needed.
SeedAdminUser__Enabled=false
SeedAdminUser__Email=
SeedAdminUser__Password=

# Keep the seed email configured on the first upgrade, even when seeding is disabled.
# The protected marker is then persisted in Identity claims and survives email changes.

# Public contact links. Empty values are hidden; these are not SMTP settings.
# PublicContact__Address=Obala pomoraca 62, Vranjic
# PublicContact__Email=
# PublicContact__SupportEmail=
# PublicContact__Phone=
# PublicContact__FacebookUrl=https://www.facebook.com/DonFraneBulic

# Initial area count on the home page, area overview and navigation (1-50).
# PublicDisplay__InitialAreaCount=5

# Invitation-only onboarding. Disabled until SMTP is configured and tested.
# Public /register remains closed even when account mail is enabled.
AccountEmail__Enabled=false
AccountEmail__PublicBaseUrl=https://example.test
AccountEmail__Host=
AccountEmail__Port=587
AccountEmail__UserName=
AccountEmail__Password=
AccountEmail__FromAddress=
AccountEmail__FromName=DFB

# Optional Windows hosting only. Set BOTH after the provider confirms a private,
# persistent, writable directory outside the deployed app and a stable Windows identity.
# DataProtection__KeyDirectory=D:\private\vranjic\keys
# DataProtection__ApplicationName=VranjicReact.Production
