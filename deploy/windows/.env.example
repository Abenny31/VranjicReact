# Production template only. Fill in locally, then upload separately as .env.
# Never copy the development .env to the server or place this file in wwwroot.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection="Server=tcp:SQL_HOST,1433;Database=SQL_DATABASE;User ID=SQL_USER;Password=REPLACE_ME;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=true"
AllowedHosts=example.hr;www.example.hr
SeedAdminUser__Enabled=false

# Under IIS, the hosting bindings/ASP.NET Core Module control the listener.
# Do not copy localhost ASPNETCORE_URLS from development.
# Same-origin React + API: leave Cors__AllowedOrigins entries unset.
# Separate static frontend only:
# Cors__AllowedOrigins__0=https://www.example.hr

# Optional Windows DPAPI key persistence; configure BOTH only after the provider
# confirms the private path, write permission, persistent user profile and stable identity.
# The directory must already exist, outside the deployed app and any public site.
# DataProtection__KeyDirectory=D:\private\vranjic\keys
# DataProtection__ApplicationName=VranjicReact.Production

# Optional public contact details (not SMTP credentials). Empty fields are hidden.
# PublicContact__Address=Obala pomoraca 62, Vranjic
# PublicContact__Email=
# PublicContact__SupportEmail=
# PublicContact__Phone=
# PublicContact__FacebookUrl=https://www.facebook.com/DonFraneBulic

# Initial area count on the home page, area overview and navigation (1-50).
# PublicDisplay__InitialAreaCount=5

# Routine production console logging. Never enable SQL sensitive-data logging.
Logging__LogLevel__Default=Warning
Logging__LogLevel__Microsoft.AspNetCore=Warning
